#!/usr/bin/lua

local ubus = require "ubus"
local json = require "luci.jsonc"

local conn = ubus.connect()
if not conn then
    error("Failed to connect to ubusd")
end

local M = {}

function M.status()
    -- قراءة حالة mwan3 الحالية من النظام مباشرة
    local handle = io.popen("mwan3 status 2>/dev/null")
    local result = handle:read("*a")
    handle:close()
    
    -- في حالة عدم وجود mwan3 مثبت، نعيد محاكاة خفيفة للتوافق
    if result == "" then
         result = "MWAN3 is active but no interfaces are monitored."
    end
    
    return { status = "active", raw_data = result }
end

local factory = {
    ["mwan3_dashboard"] = {
        status = { M.status, {} }
    }
}

return factory
